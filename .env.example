# Postgres. On Neon, DATABASE_URL is the pooled URL and DIRECT_URL the direct one; locally they are the same.
DATABASE_URL="postgresql://USER@localhost:5432/bookleaf"
DIRECT_URL="postgresql://USER@localhost:5432/bookleaf"

# 32+ random chars, e.g. `openssl rand -base64 32`
JWT_SECRET=""

# Server-only. Leave empty to run with the rule-based fallback (no AI calls).
ANTHROPIC_API_KEY=""
AI_CLASSIFY_MODEL="claude-haiku-5-5"
AI_DRAFT_MODEL="claude-sonnet-5-5"
AI_TIMEOUT_MS="15000"

# Password given to every seeded account (authors and admins).
SEED_PASSWORD="BookLeaf@2026"
